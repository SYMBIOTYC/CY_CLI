#!/bin/bash
# CY-CLI macOS app launcher.
#
# The app bundle's Info.plist points CFBundleExecutable at this script. It:
#   1. Resolves a CY API key (env, keychain, or one-time prompt) and writes it
#      to ~/.cy/auth.json so the bundled `cy` CLI can authenticate.
#   2. Starts the local responses->chat bridge (if not already running) and
#      passes the key into its environment.
#   3. Writes a default ~/.cy config pointing at the bridge.
#   4. Opens Terminal.app running the bundled `cy` binary (real TTY so the TUI
#      works), with CY_API_KEY exported in that shell.
set -e

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CY_BIN="$APP_DIR/MacOS/cy"
BRIDGE="$APP_DIR/Resources/cy_bridge.py"

CY_HOME="${CY_HOME:-$HOME/.cy}"
PORT="${CY_BRIDGE_PORT:-8790}"
mkdir -p "$CY_HOME"

AUTH_FILE="$CY_HOME/auth.json"
CONFIG="$CY_HOME/config.toml"

# --- Resolve the API key (env first, then auth.json, then prompt) ----------
KEY="${CY_API_KEY:-}"
if [ -z "$KEY" ] && [ -f "$AUTH_FILE" ]; then
  KEY="$(python3 -c "
import json, sys
try:
    with open('$AUTH_FILE') as f:
        data = json.load(f)
    v = data.get('openai_api_key', '')
    print(v if isinstance(v, str) else '')
except Exception:
    print('')
" 2>/dev/null || true)"
fi
# Strip surrounding whitespace.
KEY="$(printf '%s' "$KEY" | tr -d '[:space:]')"

if [ -z "$KEY" ]; then
  # Try the macOS keychain (if user added it with `security add-generic-password`).
  KEY="$(security find-generic-password -s cy-cli-api-key -w 2>/dev/null || true)"
  KEY="$(printf '%s' "$KEY" | tr -d '[:space:]')"
fi

if [ -z "$KEY" ]; then
  # One-time prompt via AppleScript (hidden input, modal).
  PROMPTED="$(osascript <<'APPLESCRIPT' 2>/dev/null || true"
set theResult to display dialog "Enter your CY API key (it is stored only in your local keychain):" default answer "" with hidden answer with title "CY CLI" with icon caution
return text returned of theResult
APPLESCRIPT
)"
  KEY="$(printf '%s' "$PROMPTED" | tr -d '[:space:]')"
  if [ -z "$KEY" ]; then
    osascript -e 'display alert "CY CLI" message "No API key provided. Set CY_API_KEY or add your key to ~/.cy/auth.json and try again." as critical' >/dev/null 2>&1 || true
    exit 1
  fi
  # Save to keychain (kSecGenericPassword) so we do not have to ask again.
  security delete-generic-password -s cy-cli-api-key >/dev/null 2>&1 || true
  security add-generic-password -s cy-cli-api-key -a "$USER" -w "$KEY" >/dev/null 2>&1 || true
fi

# --- Write auth.json (overwrite empty one) ----------------------------------
printf '{\n  "auth_mode": "apiKey",\n  "openai_api_key": "%s"\n}\n' "$KEY" > "$AUTH_FILE"
chmod 600 "$AUTH_FILE"

# --- Start the local bridge if it is not already running -------------------
if ! bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
  PYTHON="$(command -v python3 || true)"
  if [ -z "$PYTHON" ]; then
    echo "CY: python3 not found. Install Python 3 and try again." >&2
    exit 1
  fi
  CY_API_BASE_URL="${CY_API_BASE_URL:-https://cy.symbiotyc.workers.dev/v1}" \
  CY_BRIDGE_PORT="$PORT" \
  CY_HOME="$CY_HOME" \
  CY_API_KEY="$KEY" \
  nohup "$PYTHON" "$BRIDGE" >"$CY_HOME/bridge.log" 2>&1 &
  disown 2>/dev/null || true
  for _ in $(seq 1 50); do
    if bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
fi

# --- Default config (only written on first launch so user edits survive) ---
if [ ! -f "$CONFIG" ]; then
  cat > "$CONFIG" <<EOF
# CY Config - generated by CY-CLI launcher
model = "cy/i1a"
model_provider = "symbiotyc"
model_context_window = 128000
model_auto_compact_token_limit = 96000
model_reasoning_summary = "auto"

[model_providers.symbiotyc]
name = "SYMBIOTYC"
base_url = "http://127.0.0.1:$PORT/v1"
wire_api = "responses"
supports_websockets = false
models = ["cy/i1a"]
EOF
fi

# --- Open Terminal with the CLI and the key exported -----------------------
export CX_HOME="$CY_HOME"
export CODEX_HOME="$CY_HOME"
export CY_API_KEY="$KEY"

osascript >/dev/null 2>&1 <<APPLESCRIPT
tell application "Terminal"
    activate
    do script "export CX_HOME='$CY_HOME' CODEX_HOME='$CY_HOME' CY_API_KEY='$KEY'; cd '$HOME' && '$CY_CMD'"
end tell
APPLESCRIPT
