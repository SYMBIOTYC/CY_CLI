#!/bin/bash
# CY-CLI macOS app launcher.
#
# The app bundle's Info.plist points CFBundleExecutable at this script. It:
#   1. Starts the local responses->chat bridge (if not already running).
#   2. Writes a default ~/.cy config pointing at the bridge.
#   3. Opens Terminal.app running the bundled `cy` binary (real TTY so the TUI works).
#
# The CY API key is never stored here. The bridge resolves it at runtime from
# CY_API_KEY (exported in this shell), from ~/.cy/auth.json, or from the header
# the CLI itself sends. Create ~/.cy/auth.json if it does not exist and add your
# key there.
set -e

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CY_BIN="$APP_DIR/MacOS/cy"
BRIDGE="$APP_DIR/Resources/cy_bridge.py"

CY_HOME="${CY_HOME:-$HOME/.cy}"
PORT="${CY_BRIDGE_PORT:-8790}"
mkdir -p "$CY_HOME"

# 1. Start the local bridge if it isn't already listening.
if ! bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
  PYTHON="$(command -v python3 || true)"
  if [ -z "$PYTHON" ]; then
    echo "CY: python3 not found. Install Python 3 and try again." >&2
    exit 1
  fi
  CY_API_BASE_URL="${CY_API_BASE_URL:-https://cy.symbiotyc.workers.dev/v1}" \
  CY_BRIDGE_PORT="$PORT" \
  CY_HOME="$CY_HOME" \
  nohup "$PYTHON" "$BRIDGE" >"$CY_HOME/bridge.log" 2>&1 &
  disown 2>/dev/null || true
  for _ in $(seq 1 50); do
    if bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
fi

# 2. Default config (only written on first launch so user edits survive).
CONFIG="$CY_HOME/config.toml"
if [ ! -f "$CONFIG" ]; then
  cat > "$CONFIG" <<EOF
# CY Config - generated by CY-CLI launcher
model = "cy/i1a"
model_provider = "symbiotyc"
model_context_window = 128000
model_auto_compact_token_limit = 96000
model_reasoning_summary = "auto"

[model_providers.symbiotyc]
name = "SYMBIOTYC"
base_url = "http://127.0.0.1:$PORT/v1"
wire_api = "responses"
supports_websockets = false
models = ["cy/i1a"]
EOF
fi

# Auth file (only created on first launch; add your CY API key to it).
if [ ! -f "$CY_HOME/auth.json" ]; then
  printf '{\n  "auth_mode": "apiKey",\n  "openai_api_key": ""\n}\n' > "$CY_HOME/auth.json"
  chmod 600 "$CY_HOME/auth.json"
  echo "CY: created $CY_HOME/auth.json - add your CY API key there if you do not have CY_API_KEY set."
fi

export CX_HOME="$CY_HOME"
export CODEX_HOME="$CY_HOME"

# 3. Open a new Terminal window and run the CLI (keeps a TTY so the TUI works).
CY_CMD="$CY_BIN"
osascript >/dev/null 2>&1 <<APPLESCRIPT
tell application "Terminal"
    activate
    do script "cd '$HOME' && '$CY_CMD'"
end tell
APPLESCRIPT