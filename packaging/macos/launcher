#!/bin/bash
# CY-CLI macOS app launcher.
#
# The app bundle's Info.plist points CFBundleExecutable at this script. It:
#   1. Resolves a CY API key (env, keychain, ~/.cy/auth.json) and writes it
#      to ~/.cy/auth.json so the bundled `cy` CLI can authenticate.
#   2. Starts the local responses->chat bridge (if not already running) and
#      passes the key into its environment.
#   3. Writes a default ~/.cy config pointing at the bridge.
#   4. Opens Terminal.app running the bundled `cy` binary (real TTY so the TUI
#      works), with CY_API_KEY exported in that shell. The first screen of
#      the spawned Terminal shows a big pink CY ASCII-art logo so users
#      know the brand before the TUI takes over.
set -e

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CY_BIN="$APP_DIR/MacOS/cy"
BRIDGE="$APP_DIR/Resources/cy_bridge.py"

CY_HOME="${CY_HOME:-$HOME/.cy}"
PORT="${CY_BRIDGE_PORT:-8790}"
mkdir -p "$CY_HOME"

AUTH_FILE="$CY_HOME/auth.json"
CONFIG="$CY_HOME/config.toml"

# --- Resolve the API key (env, auth.json, keychain) ------------------------
KEY="${CY_API_KEY:-}"
if [ -z "$KEY" ] && [ -f "$AUTH_FILE" ]; then
  KEY="$(python3 -c "
import json, sys
try:
    with open('$AUTH_FILE') as f:
        data = json.load(f)
    v = data.get('cy_api_key') or data.get('CY_API_KEY') or ''
    print(v if isinstance(v, str) else '')
except Exception:
    print('')
" 2>/dev/null || true)"
fi
# Strip surrounding whitespace.
KEY="$(printf '%s' "$KEY" | tr -d '[:space:]')"

if [ -z "$KEY" ]; then
  # Try the macOS keychain (if user added it with `security add-generic-password`).
  KEY="$(security find-generic-password -s cy-cli-api-key -w 2>/dev/null || true)"
  KEY="$(printf '%s' "$KEY" | tr -d '[:space:]')"
fi

AUTH_SERVER="$APP_DIR/Resources/cy_auth_server.py"
CY_VER="$("$CY_BIN" --version 2>/dev/null | awk '{print $2}')"
[ -z "$CY_VER" ] && CY_VER="0.3.8"

# NEED_AUTH=1 means: no key yet. The interactive Google sign-in (yes/no)
# happens visibly inside the Terminal window (.command file below),
# AFTER the CY splash — never headlessly here.
NEED_AUTH=0
if [ -z "$KEY" ]; then
  NEED_AUTH=1
fi

# --- Write auth.json (only when we already have a key) ----------------------
if [ "$NEED_AUTH" = 0 ]; then
  printf '{\n  "auth_mode": "apiKey",\n  "cy_api_key": "%s"\n}\n' "$KEY" > "$AUTH_FILE"
  chmod 600 "$AUTH_FILE"
fi

# --- Start the local bridge if it is not already running -------------------
# (Only headless-start it when we have a key; otherwise the .command file
# starts it right after the interactive sign-in.)
if [ "$NEED_AUTH" = 0 ]; then
if ! bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
  PYTHON="$(command -v python3 || true)"
  if [ -z "$PYTHON" ]; then
    echo "CY: python3 not found. Install Python 3 and try again." >&2
    exit 1
  fi
  CY_API_BASE_URL="${CY_API_BASE_URL:-https://cy.symbiotyc.workers.dev/v1}" \
  CY_BRIDGE_PORT="$PORT" \
  CY_HOME="$CY_HOME" \
  CY_API_KEY="$KEY" \
  nohup "$PYTHON" "$BRIDGE" >"$CY_HOME/bridge.log" 2>&1 &
  disown 2>/dev/null || true
  for _ in $(seq 1 50); do
    if bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
fi
fi

# --- Seed SYMBIOTYC-branded syntax themes on first launch ------------------
# The 7 .tmTheme files ship inside Contents/Resources/themes/ in the .app
# bundle. We copy them into ~/.cy/themes/ if the user has never had any of
# our themes installed before. Re-running the launcher is safe: existing
# files are never overwritten (the user might have edited one).
THEMES_SRC="$APP_DIR/Resources/themes"
THEMES_DST="$CY_HOME/themes"
if [ -d "$THEMES_SRC" ]; then
  mkdir -p "$THEMES_DST"
  for t in "$THEMES_SRC"/*.tmTheme; do
    [ -f "$t" ] || continue
    name="$(basename "$t")"
    if [ ! -f "$THEMES_DST/$name" ]; then
      cp "$t" "$THEMES_DST/$name"
    fi
  done
fi

# --- Config (always written to ensure correct port, preserve theme/appearance) ---
cat > "$CONFIG" <<EOF
# CY Config - generated by CY-CLI launcher
theme = "black"
appearance = "dark"
model = "cy/i1a"
model_provider = "cy"
model_context_window = 128000
model_auto_compact_token_limit = 96000
model_reasoning_summary = "auto"
model_reasoning_effort = "none"
approval_policy = "never"
EOF

# --- Build the first-screen splash (big pink CY ASCII art) -----------------
# We build the splash with $'...' (ANSI-C quoting) so the escape character
# is the literal 0x1B byte — Terminal.app will then render the colours.
#   1;35 = bold magenta (pink), 0 = reset, 1;36 = bold cyan, 2;37 = dim grey.
#   1;31 = bold red (for shake effect).
ESC=$'\033'
PINK="${ESC}[1;35m"
RED="${ESC}[1;31m"
CYAN="${ESC}[1;36m"
DIM="${ESC}[2;37m"
BOLD="${ESC}[1m"
RESET="${ESC}[0m"
# Shake animation frames (slight horizontal offset variations)
SHAKE1="${ESC}[1;35m"
SHAKE2="${ESC}[1;35;3D"
SHAKE3="${ESC}[1;35;3C"

SPLASH_FILE="$CY_HOME/.splash.ansi"
cat > "$SPLASH_FILE" <<SPLASH_EOF
${PINK}${BOLD}
  ██████╗██╗   ██╗
 ██╔════╝╚██╗ ██╔╝
 ██║      ╚████╔╝
 ██║       ╚██╔╝
 ╚██████╗   ██║
  ╚═════╝   ╚═╝${RESET}

 ${PINK}${BOLD}CY${RESET} ${DIM}CLI v${CY_VER}${RESET}
SPLASH_EOF

# --- Open Terminal with the splash, then the CLI ---------------------------

# NOTE: heredoc below is UNQUOTED on purpose — absolute paths are baked in
# at launcher time, because Terminal.app does not inherit our environment.
# Every runtime `$` is escaped as `\$`.
CMD_FILE="$CY_HOME/.cy_launch.command"
cat > "$CMD_FILE" <<CMD_EOF
#!/bin/bash
CY_BIN="$CY_BIN"
BRIDGE="$BRIDGE"
AUTH_SERVER="$AUTH_SERVER"
CY_HOME="$CY_HOME"
AUTH_FILE="$AUTH_FILE"
PORT="$PORT"
SPLASH_FILE="$SPLASH_FILE"
CMD_FILE="$CMD_FILE"
export CX_HOME="\$CY_HOME"
export CODEX_HOME="\$CY_HOME"
export CY_HOME="\$CY_HOME"
export CY_BASE_URL="http://127.0.0.1:\$PORT/v1"
export PS1='\$ '
clear
cat "\$SPLASH_FILE"
echo ""

read_key() {
  python3 -c "
import json
try:
    with open(\"\$AUTH_FILE\") as f:
        data = json.load(f)
    v = data.get('cy_api_key') or data.get('CY_API_KEY') or ''
    print(v if isinstance(v, str) else '')
except Exception:
    print('')
" 2>/dev/null || true
}

# --- Interactive Google sign-in (only when no key yet) ---
KEY="\$(read_key | tr -d '[:space:]')"
if [ -z "\$KEY" ]; then
  printf '  Sign in with Google? [Y/n] '
  read -r ANSWER
  case "\$ANSWER" in
    [nN]*)
      echo ""
      echo "  CY needs an API key to work. Launch the app again when ready."
      read -r -p "  Press Enter to close... " _
      rm -f "\$SPLASH_FILE" "\$CMD_FILE"
      exit 1
      ;;
  esac
  echo ""
  echo "  Opening browser — sign in with Google, the key saves automatically..."
  python3 "\$AUTH_SERVER"
  KEY="\$(read_key | tr -d '[:space:]')"
  if [ -z "\$KEY" ]; then
    echo ""
    echo "  Sign-in did not complete. Launch the app again to retry."
    read -r -p "  Press Enter to close... " _
    rm -f "\$SPLASH_FILE" "\$CMD_FILE"
    exit 1
  fi
  python3 -c "
import json
p = \"\$AUTH_FILE\"
try:
    d = json.load(open(p))
except Exception:
    d = {}
k = d.get('cy_api_key') or d.get('CY_API_KEY') or ''
d.update({'auth_mode': 'apiKey', 'cy_api_key': k, 'CY_API_KEY': k})
json.dump(d, open(p, 'w'), indent=2)
" 2>/dev/null || true
  chmod 600 "\$AUTH_FILE" 2>/dev/null || true
  echo "  Signed in. Starting CY..."
  sleep 1
fi
export CY_API_KEY="\$KEY"

# --- Start the bridge if the launcher did not (no key at launch time) ---
if ! bash -c "exec 3<>/dev/tcp/127.0.0.1/\$PORT" 2>/dev/null; then
  CY_API_BASE_URL="https://cy.symbiotyc.workers.dev/v1" \\
  CY_BRIDGE_PORT="\$PORT" \\
  CY_HOME="\$CY_HOME" \\
  CY_API_KEY="\$KEY" \\
  nohup python3 "\$BRIDGE" >"\$CY_HOME/bridge.log" 2>&1 &
  disown 2>/dev/null || true
  for _ in \$(seq 1 50); do
    bash -c "exec 3<>/dev/tcp/127.0.0.1/\$PORT" 2>/dev/null && break
    sleep 0.1
  done
fi

# Shake animation: slight jitter on the CY logo
ESC=\$'\033'
for i in \$(seq 1 8); do
  OFFSET=\$((RANDOM % 3 - 1))
  if [ "\$OFFSET" -gt 0 ]; then
    printf "\${ESC}[1;35m\${ESC}[1B\${ESC}[%dC" "\$OFFSET"
  elif [ "\$OFFSET" -lt 0 ]; then
    printf "\${ESC}[1;35m\${ESC}[1B\${ESC}[%dD" "\$((-OFFSET))"
  fi
  sleep 0.15
  printf "\${ESC}[0m\${ESC}[1A"
  sleep 0.08
done

# Random click sounds at startup
for i in \$(seq 1 2); do
  SLEEP_TIME=\$(( (RANDOM % 3) + 1 ))
  sleep "\$SLEEP_TIME"
  printf '\a'
done

# Launch TUI, then clean up
sleep 1
cd "\$HOME" && "\$CY_BIN"
rm -f "\$SPLASH_FILE"
rm -f "\$CMD_FILE"
CMD_EOF
chmod +x "$CMD_FILE"

open -a Terminal "$CMD_FILE"
